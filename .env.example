# Copy to .env.local for local development. On Vercel, set the same names in Project Settings -> Environment Variables.

# Sign-in password of the web app (one user).
APP_PASSWORD=change-me

# Random key that signs the session cookie and OAuth codes. Generate: openssl rand -hex 32
# Changing it signs everyone out.
APP_SECRET=

# Bearer token of the /mcp endpoint. Generate: openssl rand -hex 32
MCP_TOKEN=

# libSQL database. Leave both empty locally: a file at data/english.db is created and migrated for you.
# In production use a Turso database (Vercel Marketplace): libsql://<name>-<org>.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Public origin, for the OAuth metadata and the connect links. On Vercel the production domain is used when this is empty.
APP_URL=
